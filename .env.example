# ============================================================
# .env.example — copy to .env and adjust. All settings optional.
# Priority: built-in defaults < .env file < real environment variables.
# ============================================================

# Package index used ONLY when `python run.py` has to install dependencies
# (first run, or after upgrading requirements.txt). Leave it empty to use
# PyPI. Set it to an internal mirror on an air-gapped or slow network:
#   PIP_INDEX_URL=https://artifactory.example.com/api/pypi/pypi/simple
# The running app never contacts it -- only the one-off install does.
# PIP_INDEX_URL=

# Address and port to listen on.
HOST=127.0.0.1
PORT=8001

# Set to false to close user registration. Existing users can still
# log in and chat; the register page redirects to login and the
# API returns 403. Values: true/false (also 1/0, yes/no, on/off).
REGISTRATION_ENABLED=true

# How long SQLite waits on a locked database before failing (ms).
# Writers additionally retry with backoff. Tune up on very busy servers.
DB_BUSY_TIMEOUT_MS=10000

# --- transport security ---
# TLS certificate for HTTPS/WSS. Empty = plain HTTP (local dev only).
# run.py warns at startup when HTTP is combined with ENC_ENABLED=false, since
# that leaves credentials and messages in cleartext with nothing protecting
# them in transit. See the warning text in run.py:warn_insecure_startup.
# Generate a local self-signed pair with:
#   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem \
#     -days 825 -nodes -subj "/CN=127.0.0.1"
# SSL_CERTFILE=cert.pem
# SSL_KEYFILE=key.pem
# Max WebSocket frame size in bytes (DoS guard).
WS_MAX_SIZE_BYTES=65536
# Concurrent WebSocket connections one user / one client IP may hold. The
# message rate limit bounds what one socket can SAY; these bound how many
# sockets can be OPEN at once, which is the other half of the same problem.
MAX_SOCKETS_PER_USER=5
MAX_SOCKETS_PER_IP=20
# Behind a reverse proxy, every user shares the proxy's IP, so MAX_SOCKETS_PER_IP
# and RATE_LOGIN_PER_MIN become site-wide ceilings. List the proxy here and
# X-Forwarded-For is believed -- but only from a request that actually arrived
# from one of these addresses, and only its rightmost untrusted hop is used, so
# a client cannot forge its way past a limit. Leave empty when the app is
# directly exposed. Examples: "127.0.0.1,::1" for local nginx, or "10.0.0.0/8".
# TRUSTED_PROXY_CIDRS=
# Absolute session lifetime in days (stolen cookies die on their own).
SESSION_LIFETIME_DAYS=30
# Idle lifetime in days: a session unused for this long is dead even inside
# the absolute window. 0 disables the idle check.
SESSION_IDLE_DAYS=14
# Rate limits per minute (sliding window): login/register per IP,
# messages per user. Raise for heavy load tests.
RATE_LOGIN_PER_MIN=20
RATE_REGISTER_PER_MIN=30
RATE_MSG_PER_MIN=120
# Admin login: a sliding window bounds how FAST attempts arrive; the settings
# below bound HOW MANY are worth making. Each failed admin login adds to a
# tally (which fades over time) and the next attempt must wait
#   step * 2 ** max(0, failures - grace)   seconds,   capped at max.
# The grace period is what keeps this from locking a human out of their own
# server: the first few fat-fingered attempts are free. With the defaults a
# scripted run is down to one guess every two minutes after ~12 tries.
# Set STEP=0 to keep only the window above.
ADMIN_LOCKOUT_STEP=1
ADMIN_LOCKOUT_GRACE=5
ADMIN_LOCKOUT_MAX=120
# How long a failure keeps its full weight, in seconds (half-life). After ten
# minutes without an attempt the tally has halved.
ADMIN_LOCKOUT_HALF_LIFE=300

# ============================================================

# --- process model ---
# Worker processes. 1 is the supported default: one process owns the
# WebSocket fan-out and the encrypted-channel state.
# >1 runs several processes against ONE shared SQLite database (WAL is enabled
# automatically) and fails fast unless you accept the consequences:
#   * with ENC_ENABLED=true it refuses to start (channel sessions live in the
#     worker that created them);
#   * otherwise each worker only broadcasts to its own sockets, so the public
#     room becomes one room per worker -> requires ALLOW_SPLIT_ROOMS=true.
# A network filesystem (NFS/CIFS/9p/...) is always rejected: SQLite's WAL mode
# needs shared memory, which those do not provide.
WORKERS=1
ALLOW_SPLIT_ROOMS=false

# --- application-layer encrypted transport (TLS alternative) ---
# Encrypts the whole connection in the browser itself (ECDH P-256 + ECDSA +
# HKDF + AES-256-GCM) and uses no cookies, so nothing readable travels in
# cleartext even without TLS. Requires no certificates.
ENC_ENABLED=true
# Handshakes per minute per IP (raise it when many users share one NAT).
ENC_HANDSHAKE_PER_MIN=120
# Show + pin (TOFU) the server key fingerprint; this is the MITM check.
ENC_SHOW_FINGERPRINT=true

# --- admin panel ---
# Address of the admin panel (letters, numbers, _ or -).
# ADMIN_PATH=/admin
# Password for the admin panel. Empty = panel disabled entirely (404).
# One credential guards every user and message in the database, so make it
# long: run.py warns at startup when it is under 12 characters or a single
# character class (the warning is advisory; the server still starts).
# Pick a long random value, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# ADMIN_PASSWORD=
# Preferred: store the password as a PBKDF2 hash, so the secret on disk is
# not itself a credential (.env, /proc/<pid>/environ and `ps` are all
# readable). Generate one with:
#   python3 -c "from app.auth import hash_password; print(hash_password(input()))"
# A hash alone enables the panel; if both are set, the hash wins.
# ADMIN_PASSWORD_HASH=
# The panel keeps its own cookie session and loads no channel code, so its
# password is posted OUTSIDE the encrypted channel. run.py therefore refuses to
# start when the panel is enabled on a plain-HTTP address other machines can
# reach (anything but loopback). Use TLS, or bind to loopback behind a tunnel;
# set this to true only if you accept a cleartext admin password on the wire.
# ADMIN_ALLOW_PLAINTEXT=false

# Directory for chat.db and .chat_secret.
# Empty = project root (dev) or ./data next to the bundle (packaged app).
# CHAT_DATA_DIR=

# Application encryption key for message storage (Fernet key).
# Empty = auto-generate once and store in .chat_secret (mode 0600).
# WARNING: losing this key makes stored messages permanently unreadable.
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CHAT_ENCRYPTION_KEY=

# Desktop notifications need no setting: the user enables them from the 🔕
# button in the chat header, and the browser grants or refuses the permission.
# There is deliberately no server-side switch and no push service, because the
# channel keys live in the browser's sessionStorage -- a service worker cannot
# read them, so a notification raised while the tab is closed would have to
# carry a message body, or a count the server could read, out of the page.
# See "Desktop notifications" in README.md.
